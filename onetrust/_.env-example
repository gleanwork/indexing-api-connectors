# OneTrust -> Glean connector configuration
#
# Copy this file to `.env` (`cp _.env-example .env`) and fill in the values.
# `run.sh` loads it with `set -a; source .env; set +a`, so do NOT wrap values
# in quotes and do NOT add spaces around the `=`.
#
# Every variable below is required: gleanConstants.py exits on startup if any
# one of them is missing from the environment.

# ---------------------------------------------------------------------------
# Glean push (Indexing) API
# ---------------------------------------------------------------------------
# Your Glean instance subdomain. The connector talks to
# https://<GLEAN_INSTANCE>-be.glean.com/api/index/v1
GLEAN_INSTANCE=acme
# Indexing API bearer token (Workspace Settings -> Setup -> API Tokens).
# Needs the "Indexing" scope. Treat this like a password.
GLEAN_PUSH_API_TOKEN=

# ---------------------------------------------------------------------------
# OneTrust API
# ---------------------------------------------------------------------------
# Base URL of your OneTrust tenant, no trailing slash.
ONETRUST_BASE_URL=https://acme.my.onetrust.com
# OAuth2 client credentials (OneTrust -> Settings -> API Credentials).
ONETRUST_CLIENT_ID=
ONETRUST_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Glean datasource definition
# ---------------------------------------------------------------------------
# Internal datasource id: lowercase, no spaces. Used as the document datasource.
DATASOURCE_NAME=onetrust
# Human-friendly name shown in the Glean UI.
DATASOURCE_DISPLAYNAME=OneTrust
# Datasource category. One of: UNCATEGORIZED, PUBLISHED_CONTENT,
# COLLABORATIVE_CONTENT, QUESTION_ANSWER, TICKETS, CRM, KNOWLEDGE_HUB, etc.
DATASOURCE_CATEGORY=PUBLISHED_CONTENT
# Landing page Glean links to for the datasource.
DATASOURCE_HOMEURL=https://acme.my.onetrust.com
# Publicly reachable icon URL for the datasource.
DATASOURCE_ICON=https://acme.my.onetrust.com/favicon.ico
# Regex matching document view URLs so Glean can attribute clicks/activity.
DATASOURCE_URLREGEX=https://acme.my.onetrust.com/.*

# ---------------------------------------------------------------------------
# Run behavior
# ---------------------------------------------------------------------------
# DEBUG=true builds requests and prints them WITHOUT calling Glean (dry run).
# Note: debug/verbose output prints secrets, so keep it off in shared logs.
DEBUG=false
# Bulk indexing is not implemented yet; leave false.
BULK_INDEX=false
